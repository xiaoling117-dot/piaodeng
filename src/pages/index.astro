---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

const jigokuSeries = allPosts
  .filter(p => p.data.tags?.includes('地獄シリーズ'))
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const featured = jigokuSeries[0]; // 序章：シリーズの入口

const recent = allPosts
  .filter(p => p.slug !== featured.slug)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);
---
<BaseLayout title="飄燈閣">
  <article class="home">

    <!-- 特集：大型アイキャッチ -->
    <section class="featured-section">
      <a href={`/piaodeng/blog/${featured.slug}/`} class="featured-img-link">
        <div class="featured-img-wrap">
          <img
            src="/piaodeng/images/hero-featured.jpg"
            alt={featured.data.title}
            class="featured-img"
          />
          <div class="featured-img-overlay">
            <h2 class="featured-img-title">{featured.data.title}</h2>
          </div>
        </div>
      </a>
      <div class="featured-body">
        <div class="featured-body-inner">
          <div class="featured-vertical-label" aria-hidden="true">
            <svg class="vertical-lantern" viewBox="0 0 32 32" aria-hidden="true">
              <rect x="14.5" y="2" width="3" height="3.5" rx="1" fill="currentColor"/>
              <path d="M9.5 7h13l-2.5 4h-8Z" fill="currentColor"/>
              <rect x="11" y="11" width="10" height="10" rx="2" fill="currentColor" opacity="0.9"/>
              <rect x="13" y="13" width="6" height="6" rx="1" fill="currentColor" opacity="0.6"/>
              <path d="M11 21h10l2.5 3.5H8.5Z" fill="currentColor"/>
              <line x1="14" y1="24.5" x2="13" y2="29" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="16" y1="24.5" x2="16" y2="29" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="18" y1="24.5" x2="19" y2="29" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            特　集
          </div>
          <div class="featured-body-text">
            <p class="featured-desc">{featured.data.description}</p>
            <a href={`/piaodeng/blog/${featured.slug}/`} class="featured-cta">読む →</a>
          </div>
        </div>
      </div>
    </section>

    <hr class="section-rule" />

    <!-- 最新記事リスト -->
    <section class="recent-section">
      <h2 class="section-title">最新記事</h2>
      <nav class="article-list">
        {recent.map(post => (
          <a href={`/piaodeng/blog/${post.slug}/`} class="article-row">
            <span class="row-date">{post.data.date}</span>
            <span class="row-title">{post.data.title}</span>
            <span class="row-arrow">→</span>
          </a>
        ))}
      </nav>
      <a href="/piaodeng/blog/all/" class="more-link">特集一覧へ →</a>
    </section>

    <hr class="section-rule" />

    <!-- 成語辞書への導線 -->
    <section>
      <a href="/piaodeng/chengyu/" class="chengyu-card">
        <span class="cat-zh">成語</span>
        <span class="cat-desc">四字熟語の辞書 — 全100語収録</span>
        <span class="cat-en">chengyu →</span>
      </a>
    </section>

  </article>

  <style>
    .home { max-width: 800px; margin: 0 auto; padding: 0 1.5rem 5rem; }

    /* ── 特集 ── */
    .featured-section { padding-top: 2.5rem; }
    .featured-img-link { display: block; text-decoration: none; }
    .featured-img-wrap {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border-dim);
    }
    .featured-img {
      width: 100%;
      height: auto;
      display: block;
      transition: transform 0.4s ease;
    }
    .featured-img-link:hover .featured-img { transform: scale(1.02); }
    .featured-img-overlay {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      top: 35%;
      padding: 1.5rem 2rem;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      background: linear-gradient(to top, oklch(0.15 0.12 263 / 0.95) 0%, oklch(0.15 0.12 263 / 0.65) 40%, transparent 100%);
    }
    .featured-img-title {
      font-family: var(--serif-jp);
      font-size: clamp(1rem, 2.5vw, 1.5rem);
      color: var(--text);
      letter-spacing: 0.05em;
      line-height: 1.5;
    }
    .featured-body { padding: 1.5rem 0 0; }
    .featured-body-inner {
      display: flex;
      gap: 1.2rem;
      align-items: flex-start;
    }
    .featured-vertical-label {
      writing-mode: vertical-rl;
      text-orientation: mixed;
      font-family: var(--serif-zh);
      font-size: 0.78rem;
      color: var(--gold);
      letter-spacing: 0.55em;
      border-right: 1px solid var(--gold-dim);
      padding: 0.2rem 0.7rem 0.2rem 0;
      flex-shrink: 0;
      opacity: 0.85;
      align-self: stretch;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }
    .vertical-lantern {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }
    .featured-body-text { flex: 1; }
    .featured-desc { font-size: 0.88rem; color: var(--text-dim); line-height: 2; margin-bottom: 1rem; }
    .featured-cta {
      font-family: var(--mono);
      font-size: 0.78rem;
      color: var(--gold);
      letter-spacing: 0.1em;
      border-bottom: 1px solid var(--gold-dim);
      padding-bottom: 2px;
    }
    .featured-cta:hover { color: var(--text); border-color: var(--text); }

    /* ── 区切り線 ── */
    .section-rule { border: none; border-top: 1px solid var(--border-dim); margin: 2.5rem 0; }

    /* ── 最新記事 ── */
    .section-title {
      font-family: var(--mono);
      font-size: 0.62rem;
      letter-spacing: 0.35em;
      color: var(--gold-dim);
      text-transform: uppercase;
      margin-bottom: 1.2rem;
    }
    .article-list { display: flex; flex-direction: column; }
    .article-row {
      display: grid;
      grid-template-columns: 6.5rem 1fr auto;
      align-items: baseline;
      gap: 1rem;
      padding: 0.9rem 0.5rem;
      border-bottom: 1px solid var(--border-dim);
      text-decoration: none;
      transition: background 0.15s;
    }
    .article-row:first-child { border-top: 1px solid var(--border-dim); }
    .article-row:hover { background: var(--surface); }
    .row-date { font-family: var(--mono); font-size: 0.62rem; color: var(--text-faint); letter-spacing: 0.04em; }
    .row-title { font-size: 0.93rem; color: var(--text); letter-spacing: 0.03em; line-height: 1.5; }
    .article-row:hover .row-title { color: var(--gold); }
    .row-arrow { font-family: var(--mono); font-size: 0.72rem; color: var(--text-faint); }
    .article-row:hover .row-arrow { color: var(--gold); }
    .more-link {
      display: inline-block;
      margin-top: 1.2rem;
      font-family: var(--mono);
      font-size: 0.68rem;
      color: var(--text-faint);
      letter-spacing: 0.1em;
    }
    .more-link:hover { color: var(--gold-dim); }

    /* ── 成語導線 ── */
    .chengyu-card {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding: 1.2rem 1rem;
      border: 1px solid var(--border-dim);
      text-decoration: none;
      transition: border-color 0.2s, background 0.2s;
    }
    .chengyu-card:hover { border-color: var(--gold-dim); background: var(--surface); }
    .cat-zh { font-family: var(--serif-zh); font-size: 1.2rem; color: var(--gold); letter-spacing: 0.05em; flex-shrink: 0; }
    .cat-desc { font-size: 0.82rem; color: var(--text-dim); flex: 1; }
    .cat-en { font-family: var(--mono); font-size: 0.62rem; color: var(--gold-dim); letter-spacing: 0.1em; flex-shrink: 0; }
  </style>
</BaseLayout>
