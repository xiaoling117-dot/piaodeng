---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const sorted = allPosts.sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());
  return sorted.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, nextPost: sorted[i + 1] ?? null },
  }));
}

const { post, nextPost } = Astro.props;
const { Content } = await post.render();
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <style is:global>
    body { background-color: #070d1c !important; background-image: none !important; }
  </style>

  <div class="post-layout">
    <article class="blog-post">
      <nav class="breadcrumb">
        <a href="/piaodeng/blog/">← 天燈報</a>
      </nav>

      <header class="post-header">
        <div class="post-meta">
          <span class="post-date">{post.data.date}</span>
          <span class="post-authors">{post.data.authors.join(' & ')}</span>
        </div>
        <h1>{post.data.title}</h1>
        {post.data.description && <p class="post-desc">{post.data.description}</p>}
      </header>

      <div class="post-body">
        <Content />
      </div>

      <div class="post-colophon" aria-hidden="true">
        <div class="colophon-seal">飄燈閣</div>
      </div>

      <footer class="post-footer">
        <a href="/piaodeng/blog/" class="back-link">← 天燈報へ</a>
        {nextPost && (
          <a href={`/piaodeng/blog/${nextPost.slug}/`} class="next-link">
            {nextPost.data.title} →
          </a>
        )}
      </footer>
    </article>

    <aside class="post-sidebar">
      {nextPost && (
        <div class="sidebar-widget">
          <p class="sidebar-label">次の記事</p>
          <a href={`/piaodeng/blog/${nextPost.slug}/`} class="sidebar-next-card">
            <p class="snc-title">{nextPost.data.title}</p>
            <p class="snc-date">{nextPost.data.date}</p>
          </a>
        </div>
      )}
      <div class="sidebar-widget sidebar-chengyu-widget">
        <p class="sidebar-label">今日の一語</p>
        <div class="scw-inner">
          <div class="scw-chars">心不在焉</div>
          <div class="scw-pinyin">xīn bù zài yān</div>
          <div class="scw-rule"></div>
          <div class="scw-mean">心がここにない。上の空で、別のことを考えている状態。</div>
          <a href="/piaodeng/chengyu/" class="scw-link">成語辞書で探す →</a>
        </div>
      </div>
    </aside>
  </div>

  <style>
    .post-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 210px;
      gap: 2.5rem;
      align-items: start;
      padding-bottom: 4rem;
    }

    .blog-post { padding: 2rem 0 2rem; }

    .breadcrumb { margin-bottom: 2.5rem; font-size: 0.8rem; }
    .breadcrumb a { color: var(--color-muted); }
    .breadcrumb a:hover { color: var(--color-gold); }

    .post-header {
      padding-bottom: 2.5rem;
      margin-bottom: 3rem;
      position: relative;
    }
    .post-header::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg,
        var(--border-dim) 0%,
        var(--gold-dim) 40%,
        var(--gold-dim) 60%,
        var(--border-dim) 100%
      );
    }
    .post-meta {
      display: flex;
      gap: 1rem;
      margin-bottom: 1rem;
      font-size: 0.75rem;
    }
    .post-date { color: var(--color-muted); }
    .post-authors { color: var(--color-gold); }

    .post-header h1 {
      font-size: clamp(1.5rem, 4vw, 2.2rem);
      letter-spacing: 0.05em;
      color: var(--color-moon);
      line-height: 1.5;
      margin-bottom: 1rem;
    }
    .post-desc { color: var(--color-muted); font-size: 0.9rem; line-height: 1.8; }

    .post-body {
      font-size: 0.95rem;
      line-height: 2.2;
      color: var(--color-moon);
    }
    .post-body :global(p) { margin-bottom: 1.5rem; opacity: 0.9; }
    .post-body :global(hr) {
      border: none;
      position: relative;
      height: 16px;
      margin: 2.8rem 0;
      overflow: visible;
    }
    .post-body :global(hr)::before {
      content: '';
      position: absolute;
      left: 0; right: 0; top: 50%;
      height: 1px;
      background: linear-gradient(90deg,
        transparent 0%,
        var(--border-dim) 15%,
        var(--gold-dim) 50%,
        var(--border-dim) 85%,
        transparent 100%
      );
    }
    .post-body :global(hr)::after {
      content: '◆';
      position: absolute;
      left: 50%; top: 50%;
      transform: translate(-50%, -50%);
      background: var(--bg);
      color: var(--gold-dim);
      font-size: 0.45rem;
      padding: 0 1rem;
      line-height: 1;
    }
    .post-body :global(strong) { color: var(--color-gold); font-weight: 600; }
    .post-body :global(em) { color: var(--color-muted); font-style: normal; }
    .post-body :global(p:has(strong:first-child)) {
      padding: 1rem 1.2rem;
      border-left: 2px solid var(--color-navy);
      margin-bottom: 0.5rem;
      opacity: 1;
    }
    .post-body :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 2rem 0;
      font-size: 0.85rem;
    }
    .post-body :global(th) {
      border: 1px solid var(--color-navy);
      padding: 0.6rem 1rem;
      color: var(--color-gold);
      text-align: left;
      font-weight: 400;
    }
    .post-body :global(td) {
      border: 1px solid var(--color-navy);
      padding: 0.6rem 1rem;
      color: var(--color-muted);
    }
    .post-body :global(code) {
      font-family: monospace;
      font-size: 0.85em;
      color: var(--color-gold);
      background: rgba(212,168,67,0.1);
      padding: 0.1em 0.4em;
    }
    .post-body :global(h2) {
      font-size: 1.1rem;
      letter-spacing: 0.1em;
      color: var(--color-moon);
      margin: 2.5rem 0 1rem;
      padding: 0.25rem 0 0.25rem 1rem;
      border-left: 2px solid var(--gold-dim);
      position: relative;
    }
    .post-body :global(h2)::before {
      content: '';
      position: absolute;
      top: 0; left: -2px;
      width: 10px; height: 2px;
      background: var(--gold-dim);
    }
    .post-body :global(h2)::after {
      content: '';
      position: absolute;
      bottom: 0; left: -2px;
      width: 6px; height: 2px;
      background: var(--gold-dim);
      opacity: 0.5;
    }
    .post-body :global(blockquote) {
      border-left: 3px solid var(--color-gold);
      margin: 1.5rem 0;
      padding: 1rem 1.5rem;
      background: rgba(26,47,90,0.2);
      color: var(--color-muted);
      font-style: italic;
    }

    .post-footer {
      padding-top: 2rem;
      border-top: 1px solid var(--color-navy);
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }
    .back-link { font-size: 0.85rem; color: var(--color-muted); white-space: nowrap; }
    .back-link:hover { color: var(--color-gold); }
    .next-link { font-size: 0.85rem; color: var(--color-muted); text-align: right; line-height: 1.6; }
    .next-link:hover { color: var(--color-gold); }

    .post-colophon {
      display: flex;
      justify-content: flex-end;
      padding: 0.5rem 0 1.5rem;
      margin-top: 3rem;
    }
    .colophon-seal {
      font-family: var(--serif-zh);
      font-size: 0.82rem;
      color: var(--crimson);
      border: 1.5px solid var(--crimson);
      padding: 0.3rem 0.65rem;
      letter-spacing: 0.2em;
      opacity: 0.7;
      line-height: 1.5;
    }

    /* ── サイドバー ── */
    .post-sidebar {
      position: sticky;
      top: 5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      padding-top: 2rem;
    }
    .sidebar-widget {
      border: 1px solid var(--color-navy);
      padding: 1.1rem 1rem;
      background: rgba(14, 22, 50, 0.55);
    }
    .sidebar-label {
      font-size: 0.58rem;
      letter-spacing: 0.3em;
      color: var(--color-gold);
      text-transform: uppercase;
      margin-bottom: 0.9rem;
      opacity: 0.75;
    }
    .sidebar-next-card {
      display: block;
      text-decoration: none;
      padding: 0.6rem 0.5rem;
      border: 1px solid transparent;
      transition: border-color 0.2s;
    }
    .sidebar-next-card:hover { border-color: var(--gold-dim); }
    .snc-title {
      font-size: 0.82rem;
      color: var(--color-moon);
      line-height: 1.7;
      margin-bottom: 0.4rem;
    }
    .snc-date { font-size: 0.63rem; color: var(--color-muted); font-family: monospace; }

    .sidebar-chengyu-widget { text-align: center; }
    .scw-chars {
      font-family: 'Noto Serif SC', serif;
      font-size: 1.5rem;
      color: var(--color-moon);
      letter-spacing: 0.2em;
      margin-bottom: 0.4rem;
    }
    .scw-pinyin {
      font-size: 0.68rem;
      color: var(--color-gold);
      letter-spacing: 0.1em;
      margin-bottom: 0.7rem;
    }
    .scw-rule {
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(212,168,67,0.35), transparent);
      margin: 0 1rem 0.7rem;
    }
    .scw-mean {
      font-size: 0.76rem;
      color: var(--color-muted);
      line-height: 1.85;
      margin-bottom: 0.9rem;
    }
    .scw-link {
      font-size: 0.68rem;
      color: var(--color-gold);
      text-decoration: none;
      letter-spacing: 0.05em;
      opacity: 0.65;
      transition: opacity 0.2s;
    }
    .scw-link:hover { opacity: 1; }

    @media (max-width: 720px) {
      .post-layout { grid-template-columns: 1fr; }
      .post-sidebar { display: none; }
      .blog-post { padding: 1.5rem 0 4rem; }
    }
  </style>
</BaseLayout>
