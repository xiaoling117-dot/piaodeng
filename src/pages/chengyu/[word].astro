---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CHENGYU_DATA } from '../../data/chengyu.js';
import { CLASSIC_STORIES } from '../../data/classicStories.js';

export function getStaticPaths() {
  const allWords = CHENGYU_DATA.flatMap(cat =>
    cat.words.map(w => ({ ...w, catId: cat.id, catName: cat.name }))
  );
  return allWords.map(word => ({
    params: { word: word.w },
    props: { word },
  }));
}

const { word } = Astro.props;
const classic = CLASSIC_STORIES[word.w] || null;
---
<BaseLayout title={`${word.w} — 古典の物語`} description={word.m}>
  <article class="classic-detail">

    <nav class="breadcrumb">
      <a href="/piaodeng/chengyu/">← 成語辞書へ戻る</a>
    </nav>

    <header class="word-header">
      <h1 class="chengyu-word">{word.w}</h1>
      <p class="chengyu-pinyin">{word.p}</p>
      <p class="chengyu-meaning">{word.m}</p>
    </header>

    {classic ? (
      <section class="classic-section">
        <h2 class="section-title">古典の物語</h2>
        <div class="classic-source">
          <span class="source-label">出典</span>
          <span class="source-text">{classic.source}</span>
        </div>
        {classic.originalText && (
          <div class="classic-original">
            <div class="original-cn-wrap">
              <p class="original-cn">{classic.originalText}</p>
              {classic.originalText.length > 5 && (
                <button class="audio-btn audio-sm" data-text={classic.originalText} data-lang="zh-CN" title="原文を聞く">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
                  </svg>
                </button>
              )}
            </div>
            {classic.originalReading && (
              <p class="original-reading">{classic.originalReading}</p>
            )}
          </div>
        )}
        <div class="classic-story">{classic.story}</div>
      </section>
    ) : (
      <p class="no-classic">この成語の古典データはまだ準備中です。</p>
    )}

    <footer class="detail-footer">
      <a href="/piaodeng/chengyu/" class="back-link">← 成語辞書一覧へ</a>
    </footer>
  </article>

  <style>
    .classic-detail { max-width: 760px; margin: 0 auto; padding: 2rem 1.5rem 5rem; }

    .breadcrumb { margin-bottom: 2.5rem; font-size: 0.8rem; }
    .breadcrumb a { color: var(--color-muted); }
    .breadcrumb a:hover { color: var(--color-gold); }

    .word-header {
      text-align: center;
      padding: 2rem 0 3rem;
      border-bottom: 1px solid var(--color-navy);
      margin-bottom: 3rem;
    }
    .chengyu-word {
      font-family: 'Noto Serif SC', serif;
      font-size: clamp(3rem, 8vw, 5rem);
      letter-spacing: 0.2em;
      color: var(--color-moon);
      margin-bottom: 0.5rem;
    }
    .chengyu-pinyin { font-size: 1rem; color: var(--color-gold); letter-spacing: 0.15em; margin-bottom: 1rem; }
    .chengyu-meaning { font-size: 0.95rem; color: var(--color-moon); line-height: 1.8; opacity: 0.85; }

    .audio-btn {
      background: none;
      border: 1px solid var(--color-navy);
      color: var(--color-muted);
      cursor: pointer;
      border-radius: 50%;
      width: 1.8rem;
      height: 1.8rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
      flex-shrink: 0;
    }
    .audio-btn svg { width: 0.8rem; height: 0.8rem; }
    .audio-btn:hover { border-color: var(--color-gold); color: var(--color-gold); }
    .audio-btn.playing { border-color: var(--color-lantern); color: var(--color-lantern); }
    .audio-sm { width: 1.8rem; height: 1.8rem; }

    .section-title {
      font-size: 0.75rem;
      letter-spacing: 0.3em;
      color: var(--color-gold);
      margin-bottom: 1.2rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid rgba(212,168,67,0.2);
    }

    .classic-section { margin-bottom: 3rem; }
    .classic-source {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      margin-bottom: 1rem;
      padding: 0.6rem 1rem;
      background: rgba(212,168,67,0.06);
      border: 1px solid rgba(212,168,67,0.2);
    }
    .source-label { font-size: 0.65rem; letter-spacing: 0.2em; color: var(--color-gold); white-space: nowrap; }
    .source-text { font-size: 0.82rem; color: var(--color-muted); }
    .classic-original {
      border: 1px solid var(--color-navy);
      border-left: 3px solid rgba(212,168,67,0.5);
      padding: 1.2rem 1.5rem;
      margin-bottom: 1.2rem;
    }
    .original-cn-wrap { display: flex; align-items: flex-start; gap: 0.75rem; }
    .original-cn {
      font-family: 'Noto Serif SC', serif;
      font-size: 1rem;
      line-height: 2;
      color: var(--color-moon);
      flex: 1;
    }
    .original-reading { font-size: 0.75rem; color: rgba(212,168,67,0.6); margin-top: 0.5rem; letter-spacing: 0.03em; }
    .classic-story {
      font-size: 0.88rem;
      line-height: 2.2;
      color: var(--color-moon);
      opacity: 0.85;
      white-space: pre-line;
    }

    .no-classic { color: var(--color-muted); font-size: 0.88rem; padding: 2rem 0; }

    .detail-footer { padding-top: 2rem; border-top: 1px solid var(--color-navy); }
    .back-link { font-size: 0.85rem; color: var(--color-muted); }
    .back-link:hover { color: var(--color-gold); }
  </style>

  <script>
    document.querySelectorAll('.audio-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.dataset.text;
        const lang = btn.dataset.lang || 'zh-CN';
        if (!text) return;
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(text);
        utter.lang = lang;
        utter.rate = 0.85;
        btn.classList.add('playing');
        utter.onend = () => btn.classList.remove('playing');
        utter.onerror = () => btn.classList.remove('playing');
        window.speechSynthesis.speak(utter);
      });
    });
  </script>
</BaseLayout>
