---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { STORIES } from '../../data/stories.js';
---
<BaseLayout title="物語廊" description="同じ場面を4つの難易度で読む。中日対訳リーダー。">
  <style is:global>
    body { background-color: #070d1c !important; background-image: none !important; }
  </style>
  <div class="story-index">

    <div class="hero">
      <img src="/piaodeng/images/header-enkonshi.png" alt="" class="hero-bg" />
      <div class="hero-overlay"></div>
      <div class="hero-body">
        <p class="hero-pinyin">wù yǔ láng</p>
        <h1 class="hero-title">物　語　廊</h1>
        <div class="hero-rule-wrap">
          <div class="hero-rule"></div>
          <span class="hero-rule-star">✦</span>
          <div class="hero-rule"></div>
        </div>
        <p class="hero-sub">同じ場面を、四つの難易度で読む。<br>成語が生きた言葉になる場所。</p>
      </div>
    </div>

    <ul class="story-list">
      {STORIES.map((story, i) => (
        <li class="story-card">
          <a href={`/piaodeng/story/${story.slug}/`} class="story-card-link">
            <div class="card-left">
              <span class="card-num">0{i + 1}</span>
              <div class="card-chengyu-block">
                <span class="card-chengyu-zh">{story.chengyu}</span>
                <span class="card-chengyu-reading">{story.chengyu_reading}</span>
              </div>
            </div>
            <div class="card-body">
              <h2 class="card-title-zh">{story.zh_title}</h2>
              <p class="card-title-jp">{story.title}</p>
              <p class="card-desc">{story.desc}</p>
              <p class="card-chengyu-meaning">{story.chengyu_meaning}</p>
            </div>
            <div class="card-right">
              <span class="card-level-badge">4段階</span>
              <span class="card-arrow">→</span>
            </div>
          </a>
        </li>
      ))}
    </ul>

  </div>
</BaseLayout>

<style>
  .story-index {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  /* ── ヒーロー（天燈報共通スタイル） ── */
  .hero {
    position: relative;
    height: 240px;
    overflow: hidden;
    border-radius: 4px;
    margin: 1.5rem 0 2.2rem;
    border: 1px solid rgba(200,155,83,.22);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(4,8,20,.88) 0%, rgba(4,8,20,.6) 60%, rgba(4,8,20,.78) 100%);
  }
  .hero-body {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem;
  }
  .hero-pinyin {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 0.82rem;
    color: rgba(200,155,83,.6);
    letter-spacing: 0.25em;
    margin-bottom: 0.35rem;
  }
  .hero-title {
    font-family: 'Shippori Mincho', serif;
    font-size: 2.4rem;
    font-weight: 600;
    color: var(--gold);
    letter-spacing: 0.35em;
    text-shadow: 0 0 40px var(--gold-glow);
    margin-bottom: 0.7rem;
    line-height: 1;
  }
  .hero-rule-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 160px;
    margin: 0 auto 0.75rem;
  }
  .hero-rule { flex: 1; height: 1px; background: rgba(200,155,83,.45); }
  .hero-rule-star { color: #c89b53; font-size: 9px; flex-shrink: 0; }
  .hero-sub {
    font-family: 'Noto Serif JP', serif;
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.04em;
    line-height: 1.9;
  }

  .story-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .story-card {
    border: 1px solid var(--border-dim);
    margin-bottom: 0.6rem;
    background: rgba(14, 22, 50, 0.3);
    transition: border-color 0.2s, background 0.2s;
  }
  .story-card:hover {
    border-color: var(--gold-dim);
    background: rgba(14, 22, 50, 0.55);
  }
  .story-card-link {
    display: grid;
    grid-template-columns: 90px 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.4rem 1.5rem;
    text-decoration: none;
    color: inherit;
  }

  .card-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    text-align: center;
  }
  .card-num {
    font-family: var(--mono);
    font-size: 1.1rem;
    color: var(--gold-dim);
    letter-spacing: 0.05em;
    opacity: 0.7;
  }
  .card-chengyu-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }
  .card-chengyu-zh {
    font-family: var(--serif-zh);
    font-size: 1rem;
    color: var(--gold);
    letter-spacing: 0.08em;
  }
  .card-chengyu-reading {
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--jade-dim);
    letter-spacing: 0.06em;
  }

  .card-body { flex: 1; }
  .card-title-zh {
    font-family: var(--serif-zh);
    font-size: 1.2rem;
    color: var(--text);
    letter-spacing: 0.05em;
    margin-bottom: 0.15rem;
  }
  .card-title-jp {
    font-family: var(--serif-jp);
    font-size: 0.78rem;
    color: var(--text-dim);
    margin-bottom: 0.45rem;
    letter-spacing: 0.05em;
  }
  .card-desc {
    font-family: var(--serif-jp);
    font-size: 0.75rem;
    color: var(--text-faint);
    line-height: 1.8;
    letter-spacing: 0.03em;
    margin-bottom: 0.3rem;
  }
  .card-chengyu-meaning {
    font-family: var(--serif-jp);
    font-size: 0.68rem;
    color: rgba(212,168,67,0.5);
    letter-spacing: 0.03em;
  }

  .card-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .card-level-badge {
    font-family: var(--mono);
    font-size: 0.58rem;
    color: var(--jade-dim);
    border: 1px solid rgba(80,160,120,0.3);
    padding: 0.2rem 0.5rem;
    letter-spacing: 0.1em;
  }
  .card-arrow {
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--gold-dim);
    transition: transform 0.2s, color 0.2s;
  }
  .story-card:hover .card-arrow {
    transform: translateX(4px);
    color: var(--gold);
  }

  @media (max-width: 600px) {
    .story-card-link { grid-template-columns: 70px 1fr; padding: 1.1rem 1rem; }
    .card-right { display: none; }
  }
</style>
